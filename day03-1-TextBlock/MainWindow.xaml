<Window x:Class="day03_1_TextBlock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:day03_1_TextBlock"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        
        <TextBlock Text="Hello, World!" FontSize="20"/>

        <TextBlock Text="加粗+斜体" FontWeight="Bold" FontStyle="Italic" FontSize="16"/>
        <TextBlock Text="微软雅黑字体" FontFamily="微软雅黑" FontSize="16"/>

        <!-- 3. 颜色 + 下划线 -->
        <TextBlock Text="红底白字 + 下划线" Foreground="White" Background="Red" TextDecorations="Underline" FontSize="16"/>

        <!-- 4. 长文本自动换行 -->
        <TextBlock Text="这是一段很长很长的文本，用来演示 TextWrapping 自动换行，当它超过宽度的时候就会自动换到下一行显示。" TextWrapping="Wrap" Width="300"/>

        <!-- 5. 手动换行 -->
        <TextBlock FontSize="16">第一行<LineBreak/>第二行</TextBlock>

        <!-- 6. 超链接 -->
        <TextBlock FontSize="16">
        <Hyperlink Click="Hyperlink_Click">点我（超链接）</Hyperlink>
        </TextBlock>
        

    </StackPanel>
</Window>
