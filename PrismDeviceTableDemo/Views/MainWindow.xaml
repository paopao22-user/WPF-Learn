<Window x:Class="PrismDeviceTableDemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="600" Width="650" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="30">

            <TextBlock Text="设备类型"
                       VerticalAlignment="Center"/>

            <ComboBox Width="120"
                      Margin="5,0,20,0"
                      ItemsSource="{Binding DeviceTypes}"
                      SelectedItem="{Binding SelectedDeviceType}"/>

            <TextBlock Text="设备状态"
                       VerticalAlignment="Center"/>

            <ComboBox Width="120"
                      Margin="5,0"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"/>


        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="30">

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="设备名称: "
                           VerticalAlignment="Center"/>

                <TextBox Width="120"
                         Margin="5,0,20,0"
                         Text="{Binding EditDeviceName}"/>

                <TextBlock Text="设备类型: "
                           VerticalAlignment="Center"/>

                <ComboBox Width="100"
                         Margin="5,0,20,0"
                          ItemsSource="{Binding DeviceTypes}"
                          SelectedItem="{Binding EditDeviceType}"/>

                <TextBlock Text="IP地址："
                            VerticalAlignment="Center"/>

                <TextBox Width="130"
                         Margin="5,0"
                         Text="{Binding EditIpAddress}"/>   


            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">

                <TextBlock Text="设备状态："
                            VerticalAlignment="Center"/>

                <ComboBox Width="100"
                          Margin="5,0,20,0"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding EditStatus}"/>

                <Button Content="新增"
                        Width="80"
                        Margin="5"
                        Command="{Binding AddCommand}"/>

                <Button Content="修改"
                        Width="80"
                        Margin="5"
                        Command="{Binding UpdateCommand}"/>

                <Button Content="删除"
                        Width="80"
                        Margin="5"
                        Command="{Binding DeleteCommand}"/> 

            </StackPanel>

            <!-- 查询区域 -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,20">

                <TextBlock Text="搜索："
                            VerticalAlignment="Center"/>

                <TextBox Width="140"
                         Margin="5,0,20,0"
                         Text="{Binding SearchKeyword}"/>


                <TextBlock Text="类型："
                            VerticalAlignment="Center"/>

                <ComboBox Width="100"
                          Margin="5,0,20,0"
                          ItemsSource="{Binding DeviceTypes}"
                          SelectedItem="{Binding SelectedDeviceType}"/> 


                <TextBlock Text="状态："
                            VerticalAlignment="Center"/>

                <ComboBox Width="100"
                          Margin="5,0,20,0"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"/>


                <Button Content="查询"
                        Width="80"
                        Command="{Binding SearchCommand}"/> 

            </StackPanel>

        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  Margin="30">

            <DataGrid.Columns>
                <DataGridTextColumn Header="编号"
                                    Binding="{Binding Id}"/>

                <DataGridTextColumn Header="设备名称"
                                    Binding="{Binding DeviceName}"/>

                <DataGridTextColumn Header="设备类型"
                                    Binding="{Binding DeviceType}"/>

                <DataGridTextColumn Header="IP地址"
                            Binding="{Binding IpAddress}"/>

                <DataGridTextColumn Header="状态"
                            Binding="{Binding Status}"/>

            </DataGrid.Columns>


        </DataGrid>

        <StackPanel Grid.Row="3"
                    Margin="30,10">

            <TextBlock FontSize="18">
                <Run Text="当前选中设备: "/>
                <Run Text="{Binding SelectedDevice.DeviceName}"/>

            </TextBlock>

            <TextBlock FontSize="18">
                <Run Text="IP地址: "/>
                <Run Text="{Binding SelectedDevice.IpAddress}"/>

            </TextBlock>

            <TextBlock FontSize="18">
                <Run Text="当前状态: "/>
                <Run Text="{Binding SelectedDevice.Status}"/>

            </TextBlock> 

        </StackPanel>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>
