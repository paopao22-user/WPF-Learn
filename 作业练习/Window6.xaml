<Window x:Class="作业练习.Window6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:作业练习"
        mc:Ignorable="d"
        Title="Window6" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Expander Header="设备参数" IsExpanded="False" Margin="10">
                <StackPanel>
                    <TextBlock Text="设备名称：测试设备"/>
                    <TextBlock Text="IP：192.168.1.10"/>
                    <TextBlock Text="端口：502"/>
                </StackPanel>
            </Expander>

            <Expander>
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="状态:" Margin="5"/>
                        <TextBlock Text="良好" Margin="5"/>
                    </StackPanel>
                </Expander.Header>

                <TextBlock Text="你好啊"/>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
