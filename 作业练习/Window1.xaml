<Window x:Class="作业练习.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:作业练习"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <CheckBox x:Name="chk1" Content="启用报警" IsChecked="True"/>
            <CheckBox x:Name="chk2" Content="报警消除" IsChecked="False" Click="CheckBox_Click"/>

            <CheckBox>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="设备状态:"/>
                    <TextBlock Text="启用" Foreground="Green"/>
                </StackPanel>
            </CheckBox>
        </StackPanel>
    </Grid>
</Window>
