<Window x:Class="作业练习.Window5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:作业练习"
        mc:Ignorable="d"
        Title="Window5" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="开始日期"/>
        <DatePicker x:Name="dpStart" Margin="0 5 0 10"/>
        <TextBlock Text="结束日期"/>
        <DatePicker x:Name="dpEnd" Margin="0 5 0 10"/>
        <DatePicker x:Name="dpDate" SelectedDateChanged="dpDate_SelectedDateChanged"/>

        <Button Content="查询" Click="Button_Click" Width="100" HorizontalAlignment="Center" Background="Red"/>
    </StackPanel>
</Window>
