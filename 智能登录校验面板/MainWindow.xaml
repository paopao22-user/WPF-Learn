<Window x:Class="智能登录校验面板.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:智能登录校验面板"
        xmlns:vm="clr-namespace:智能登录校验面板.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="420" Width="460">

    <!-- 挂载 LoginViewModel -->
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 按钮现代化样式 -->
        <Style x:Key="ModernBtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <!-- 精准置灰触发器 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtnStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnStyle}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <!-- 居中纯白卡片 -->
        <Border Width="340" Background="White" CornerRadius="16" Padding="30,25"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#0F172A" Direction="270" Opacity="0.08" ShadowDepth="6"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🔐 系统安全登录" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E293B"/>
                <TextBlock Text="手动通知流（RaiseCanExecuteChanged）" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <!-- 账号输入 -->
                
                <TextBlock Text="用户账号" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="6, 4" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,5"/>

                <!-- 密码输入 (注意必须带 UpdateSourceTrigger=PropertyChanged) -->
                <TextBlock Text="登录密码 (至少 6 位)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="6,4" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

                <!-- 按钮组 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="🚀 立即登录"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource ModernBtnStyle}"/>

                    <Button Grid.Column="2" Content="🧹 清空"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryBtnStyle}"/>


                </Grid>


            </StackPanel>
        </Border>
    </Grid>
</Window>
