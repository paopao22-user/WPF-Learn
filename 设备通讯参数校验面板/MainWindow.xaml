<Window x:Class="设备通讯参数校验面板.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:设备通讯参数校验面板"
        xmlns:vm="clr-namespace:设备通讯参数校验面板.ViewModels"
        mc:Ignorable="d"
        Title="设备通讯参数校验面板" Height="520" Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>

        <vm:DeviceConfigViewModel/>

    </Window.DataContext>

    <Grid Background="#F3F4F6">

        <Border Width="500" 
                Padding="35"
                Background="White"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="设备通讯配置"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="设备名称"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"
                         Padding="10, 5"
                         Margin="0,0,0,18"/>

                <TextBlock Text="IP 地址"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"
                         Padding="10, 5"
                         Margin="0,0,0,18"/>

                <TextBlock Text="端口号"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         FontSize="14"
                         Padding="10, 5"
                         Margin="0,0,0,18"/>

                <TextBlock Text="采样周期"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Height="36"
                         Padding="10, 5"
                         Margin="0,0,0,25"/>
                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                        
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="建立连接"
                            Height="42"
                            FontSize="15"
                            Command="{Binding ConnectCommand}"/>

                    <Button Grid.Column="2"
                            Content="清空参数"
                            Height="42"
                            FontSize="15"
                            Command="{Binding ResetCommand}"/>
                </Grid>

            </StackPanel>



        </Border>

    </Grid>
</Window>
