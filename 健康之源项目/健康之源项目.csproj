  <ItemGroup>
    <!-- 批量将所有图片作为 WPF 嵌入资源（在 XAML 中用 /Images/xxx.png 访问） -->
    <Resource Update="Images\**\*" />
    <Resource Update="Resources\**\*" />
    <!-- 批量将所有图片复制到输出目录（如果在代码中需要物理文件读取） -->
    <None Update="Images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Update="Images\front office.png">
