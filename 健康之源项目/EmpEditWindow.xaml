<Window x:Class="健康之源项目.EmpEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:健康之源项目"
        mc:Ignorable="d"
        Title="员工信息" Height="380" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="姓名" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"/>
        <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="1" Margin="5" VerticalAlignment="Center" Height="32"/>
        <TextBlock Text="年龄" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="AgeTextBox" Grid.Row="1" Grid.Column="1" Margin="5" VerticalAlignment="Center" Height="32"/>
        <TextBlock Text="生日" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <DatePicker x:Name="BirthdayPicker" Grid.Row="2" Grid.Column="1" Margin="5" VerticalAlignment="Center" Height="32"/>
        <TextBlock Text="地址" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="AddressTextBox" Grid.Row="3" Grid.Column="1" Margin="5" VerticalAlignment="Center" Height="32"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="确定" Width="80" Margin="5" Click="OkButton_Click" Height="32"/>
            <Button Content="取消" Width="80" Margin="5" Click="CancelButton_Click" Height="32"/>
        </StackPanel>
    </Grid>
</Window>

