<Page x:Class="健康之源项目.EmpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:健康之源项目"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmpPage">

    <Page.Resources>
        <Style TargetType="Button" x:Key="AddBtn">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="LightSeaGreen"/>

            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        
        <!--添加按钮-->
        <Button Style="{StaticResource AddBtn}"
                Click="AddButton_Click">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/员工管理.png" Height="20" Width="20"/>

                <TextBlock Text="添加" Foreground="White" FontSize="15" Margin="5,0,0,0"/>
            </StackPanel>
        </Button>


        <GroupBox Grid.Row="1" Padding="10">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/员工管理.png" Height="20" Width="20"/>

                    <TextBlock Text="员工信息展示" FontSize="11" Foreground="CadetBlue" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </GroupBox.Header>

            <DataGrid x:Name="EmpDate" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="年龄" Binding="{Binding Age}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="生日" Binding="{Binding Bir}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="操作" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Images/修改按钮面.png" Width="15" Height="15" Cursor="Hand" MouseLeftButtonDown="EditImage_MouseLeftButtonDown"/>
                                    <Image Source="/Images/删除.png" Width="15" Height="15" Margin="10,0,0,0" Cursor="Hand" MouseLeftButtonDown="DeleteImage_MouseLeftButtonDown"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Page>
