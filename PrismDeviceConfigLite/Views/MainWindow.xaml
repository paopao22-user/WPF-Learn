<Window x:Class="PrismDeviceConfigLite.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrismDeviceConfigLite"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="设备通讯参数配置" Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Grid>

        <!-- 白色圆角卡片容器 -->
        <Border Background="White"
                CornerRadius="10"
                Padding="30,25"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- 1. 标题区 -->
                <TextBlock Text="设备通讯参数配置"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#1F2937"
                           Margin="0,0,0,15"/>

                <!-- 分割线 -->
                <Separator Background="#E5E7EB" Margin="0,0,0,20"/>

                <!-- 2. 表单输入区 (Grid 两列精细对齐) -->
                <Grid Margin="0,0,0,25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <!-- 设备名称 -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="设备名称: "
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBox Grid.Column="1" Grid.Row="0"
                             Height="32"
                             Padding="8,4"
                             VerticalAlignment="Center"
                             Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- IP 地址 -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="IP地址: "
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBox Grid.Row="2" Grid.Column="1"
                             Height="32"
                             Padding="8,4"
                             VerticalAlignment="Center"
                             Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 端口号 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" 
                               Text="端口号：" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox Grid.Row="4" Grid.Column="1" 
                             Height="32" 
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>



                </Grid>

                <!-- 3. 操作按钮区 -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">

                    <Button Content="保存配置"
                            Width="110" Height="34"
                            FontSize="14"
                            Background="#2563EB" Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,20,0"/>
                    <Button Content="恢复默认"
                            Width="110" Height="34"
                            FontSize="14"
                            Background="#E5E7EB" Foreground="#374151"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding ResetCommand}"/>

                </StackPanel>

                <!-- 4. 底部状态反馈栏 -->
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#6B7280"/>


            </StackPanel>


        </Border>

    </Grid>
</Window>
