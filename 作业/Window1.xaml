<Window x:Class="作业.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:作业"
        mc:Ignorable="d"
        Title="HelloWorld - www.wpfsoft.com" Height="480" Width="800">
    <Grid>
        <!-- 行定义 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 顶部 -->
        <Grid Grid.Row="0" Background="#126A74">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="20" Foreground="White" Margin="20 20">
                WPF中文网应用程序
            </TextBlock>

            <Border Grid.Column="1" Width="80" Height="40" Background="#CA5100" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
                <TextBlock Text="退出系统" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 中间区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 中间左侧区域  3个border-->
            <StackPanel Grid.Column="0">
                <Border Height="90" Width="220" Background="#439D84" Margin="10">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="参数区域" Foreground="White" FontSize="15"/>
                </Border>

                <Border Height="90" Width="220" Background="#9CDC7B" Margin="10">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="参数区域" Foreground="White" FontSize="15"/>
                </Border>

                <Border Height="90" Width="220" Background="#E97752" Margin="10">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="参数区域" Foreground="White" FontSize="15"/>
                </Border>

            </StackPanel>

            <!-- 中间主体区域,一个grid不设置行列 -->
            <Grid Grid.Column="1" Background="#FDD2B2" Margin="10">
                <TextBlock Text="主体区域" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" FontSize="15"/>

                <Border Margin="10" Background="Red" Width="100" Height="100" CornerRadius="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="开始运行" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                </Border>
            </Grid>

        </Grid>

        <!-- 底部区域 -->
        <Border Grid.Row="2" Background="#CA5100">
            <TextBlock Text="版本:1.0.2.5  |  版权所有:中国WPF中文网科技有限公司 www.wpfsoft.com" Margin="10 5 10 5" Foreground="White" FontSize="10"/>
        </Border>

    </Grid>
</Window>
