<Window x:Class="day08_1CommandBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:day08_1CommandBase"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="txtFile" Width="200" Height="30" Margin="10,10,0,0" HorizontalAlignment="Left"/>
        <Button Content="打开文件" Width="100" Height="30" Margin="10,60,0,0" HorizontalAlignment="Left"
                Command="{Binding OpenCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                CommandTarget="{Binding ElementName=txtFile}"/>
    </Grid>
</Window>
