<Window x:Class="智能计算器.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:智能计算器"
        xmlns:vm="clr-namespace:智能计算器.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="480">

    <!-- 1.挂载 ViewModel -->
    <Window.DataContext>
        <vm:CounterViewModel/>
    </Window.DataContext>

    <!-- 2. 全局样式资源定义 -->
    <Window.Resources>
        <Style x:Key="ModernBtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="82"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停变亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <!-- 命令禁用时置灰 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- 主色调加一按钮样式 (高亮靛蓝) -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnStyle}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

        <!-- 3. 主界面布局 -->
    <Grid>
        <!-- 居中纯白微悬浮卡片 -->
        <Border Width="340" Background="White" CornerRadius="16" Padding="30,25"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- 卡片柔和浮雕阴影 -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#0F172A" Direction="270" 
                                  Opacity="0.08" ShadowDepth="6"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- 顶部标题区 -->
                <TextBlock Text="智能计算器" FontSize="18" FontWeight="Bold"
                           Foreground="#1E293B" HorizontalAlignment="Center"/>

                <!-- 核心大号数值展示区 -->
                <TextBlock Text="{Binding Count}" FontSize="56" FontWeight="Bold"
                           Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,15,0,0"/>

                <!-- 状态提示副标题 -->
                <TextBlock Text="当前允许范围:0-10" FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <!-- 底部操作按钮区 (横向排布) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- 减一按钮 (次要样式) -->
                    <Button Content="➖ 减一"
                            Command="{Binding SubCommand}"
                            Style="{StaticResource ModernBtnStyle}"/>

                    <!-- 加一按钮 (主要高亮样式) -->
                    <Button Content="➕ 加一" 
                            Command="{Binding AddCommand}" 
                            Style="{StaticResource PrimaryBtnStyle}"/>
                    
                    <!-- 清零按钮 (次要样式) -->
                    <Button Content="🔄 清零" 
                            Command="{Binding ResetCommand}" 
                            Style="{StaticResource ModernBtnStyle}"/>


                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
